# Committed defaults for the local Keycloak that ships with this demo.
# Realm + users are imported from ./setup/realm.json by `docker compose up`.
#
#   docker compose up -d          # Keycloak on :8080 (admin / admin)
#   npm run dev                   # demo on :3000
#   log in as  admin / admin  (role: admin)  or  user / user  (role: user)
#
# These are a PUBLIC OIDC client (Authorization Code + PKCE, no secret) — safe to commit.
# Override in .env.local to point at another realm.

NEXT_PUBLIC_KC_AUTHORITY=http://localhost:8080/realms/cinnamon-example
NEXT_PUBLIC_KC_CLIENT_ID=cinnamon-example-front

# Server-side token validation (getServerSession) verifies the access token
# against this issuer's JWKS. Must match NEXT_PUBLIC_KC_AUTHORITY.
KC_ISSUER=http://localhost:8080/realms/cinnamon-example
